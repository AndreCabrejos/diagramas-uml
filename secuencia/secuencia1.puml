@startuml "Secuencia 1 - Registro e Inicio de Sesion (HU-01) - Analisis de Robustez"
skinparam ParticipantBackgroundColor #C7F4FF
skinparam ParticipantBorderColor #7A1631
skinparam ActorBackgroundColor #C7F4FF
skinparam ActorBorderColor #7A1631
skinparam ArrowColor #7A1631
skinparam LifeLineBorderColor #7A1631
skinparam BoundaryBackgroundColor #C7F4FF
skinparam ControlBackgroundColor #FFF9C4
skinparam EntityBackgroundColor #E8DAEF

actor "Usuario ULima" as U

boundary "Pantalla Login /\nRegistro (auth.js)" as UI
control "AuthController" as CTRL
control "authMiddleware\n(verifyToken)" as MW
entity "User" as E_User
database "MySQL\n(tabla users)" as DB

note over U, DB : Flujo 1 de 2: Registro de un nuevo usuario

U -> UI : Completa nombre, correo\ny contraseña
UI -> CTRL : POST /api/auth/register
activate CTRL

CTRL -> CTRL : Valida campos obligatorios\ny longitud de contraseña (>=6)
CTRL -> E_User : findByEmail(email)
E_User -> DB : SELECT * FROM users\nWHERE email = ?
DB --> E_User : fila o vacío
E_User --> CTRL : usuario existente / null

alt correo ya registrado
  CTRL --> UI : 409 Correo ya existe
  UI --> U : Muestra alerta de error
else datos válidos
  CTRL -> CTRL : bcrypt.hash(password, 12)
  CTRL -> E_User : create(nombre, email,\npasswordHash, rol)
  E_User -> DB : INSERT INTO users (...)
  DB --> E_User : id insertado
  E_User --> CTRL : usuario creado
  CTRL -> CTRL : jwt.sign({id, email, rol})
  CTRL --> UI : 201 { token, user }
  UI --> U : Guarda token y muestra\npantalla principal
end
deactivate CTRL

note over U, DB : Flujo 2 de 2: Inicio de sesion de un usuario existente

U -> UI : Ingresa correo y contraseña
UI -> CTRL : POST /api/auth/login
activate CTRL

CTRL -> E_User : findByEmail(email)
E_User -> DB : SELECT * FROM users\nWHERE email = ?
DB --> E_User : fila o vacío
E_User --> CTRL : usuario / null

alt usuario no existe
  CTRL --> UI : 404 Usuario no registrado
  UI --> U : Sugiere crear cuenta
else usuario existe
  CTRL -> CTRL : bcrypt.compare(password,\npassword_hash)
  alt contraseña inválida
    CTRL --> UI : 401 Credenciales inválidas
    UI --> U : Muestra alerta de error
  else contraseña correcta
    CTRL -> CTRL : jwt.sign({id, email, rol},\nexpiresIn 24h)
    CTRL --> UI : 200 { token, user }
    UI --> U : Guarda token y muestra\npantalla principal
  end
end
deactivate CTRL

note over MW
  authMiddleware.verifyToken se
  reutiliza en todos los endpoints
  protegidos (bounded contexts
  de Rutas, Buses, Home y Planes).
end note
@enduml