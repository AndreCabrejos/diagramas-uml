@startuml "Diagrama de Despliegue - EsperaRojo ULima"

skinparam node {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam artifact {
  BackgroundColor #FFF9C4
  BorderColor #7A1631
}
skinparam database {
  BackgroundColor #E8DAEF
  BorderColor #7A1631
}
skinparam cloud {
  BackgroundColor #F5F5F5
  BorderColor #7A1631
}
skinparam Arrow {
  Color #7A1631
}

node "Dispositivo del Usuario\n<<smartphone / laptop>>" as ClienteDevice {

  node "Navegador Web\n<<Chrome / Safari>>" as Browser {
    artifact "Cliente Web EsperaRojo\n(HTML5 + CSS3 + JS vanilla)" as AppWeb
    artifact "Módulos: auth.js, home.js,\nrutas.js, mapa.js, planes.js" as Modulos
    component "Geolocation API\n(navegador)" as GeoAPI
  }

  AppWeb --> Modulos
  Modulos --> GeoAPI : navigator.geolocation
}

node "Servidor de Aplicación\n<<Node.js runtime>>" as ServerApp {

  artifact "Express.js\nAPI REST (puerto 3000)" as ExpressApp

  component "Middleware\n(CORS, JWT verifyToken,\nerrorHandler)" as MW

  component "Controllers\n(auth, home, route, bus, plan)" as Controllers

  component "Models\n(mysql2 / prepared statements)" as Models

  artifact "Frontend estático\nservido por Express\n(express.static)" as StaticFiles

  ExpressApp --> MW
  MW --> Controllers
  Controllers --> Models
  ExpressApp --> StaticFiles
}

node "Servidor de Base de Datos\n<<Docker container: mysql:8.0>>" as DBServer {
  database "MySQL 8\nesperarojo_db" as MySQL {
    artifact "users, routes, stops,\nroute_stops, buses,\nsubscription_plans,\nuser_subscriptions"
  }
}

cloud "OpenStreetMap\n<<CDN de tiles>>" as OSM {
  artifact "Tile Server\n(mapas base para Leaflet)"
}

' ---- Conexiones ----
AppWeb --> ExpressApp : HTTPS\nfetch() /api/**\n(JSON + JWT Bearer)

StaticFiles ..> AppWeb : sirve HTML/CSS/JS\nen la primera carga

Models --> MySQL : TCP 3306\n(mysql2 connection pool)

AppWeb --> OSM : HTTPS\nsolicita tiles del mapa\n(directo desde el cliente)

note bottom of ServerApp
  Despliegue actual (Sprint 1):
  un único proceso Node/Express
  sirve la API REST y el frontend
  estático desde el mismo puerto.
end note

note bottom of DBServer
  Contenedor gestionado vía
  docker-compose.yml
  (volumen persistente mysql_data).
end note

note bottom of OSM
  No existe pasarela de pago ni
  servicio de notificaciones push:
  las suscripciones se registran
  directo en BD y no hay envío
  de notificaciones en este sprint.
end note

@enduml
