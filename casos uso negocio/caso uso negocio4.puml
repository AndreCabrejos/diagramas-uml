@startuml "BUC4 - Gestionar Servicio (Negocio)"
left to right direction
skinparam usecase {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam actor {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam Arrow {
  Color #7A1631
}

actor/ "Administrador\ndel Sistema" <<Business Worker>> as Admin
actor/ "Operador de\nTransporte" <<Business Actor>> as Op

usecase/ "Gestionar\nServicio" as BUC4
usecase/ "Mantener rutas y\nparaderos actualizados" as B1
usecase/ "Supervisar la calidad\nde la información" as B2
usecase/ "Proveer Datos de\nRutas y Buses" as BUC6

Admin --> BUC4

BUC4 ..> B1 : <<include>>
BUC4 ..> B2 : <<include>>
BUC4 ..> BUC6 : <<include>>

Op --> BUC6
@enduml
