@startuml "BUC3 - Recibir Recomendaciones (Negocio)"
left to right direction
skinparam usecase {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam actor {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam Arrow {
  Color #7A1631
}

actor/ "Usuario ULima" <<Business Actor>> as User

usecase/ "Recibir\nRecomendaciones" as BUC3
usecase/ "Conocer el mejor horario\npara viajar" as B1
usecase/ "Conocer el bus con\nmenor aforo" as B2
usecase/ "Monitorear\nBuses y Aforo" as BUC2

User --> BUC3

BUC3 ..> B1 : <<include>>
BUC3 ..> B2 : <<include>>
BUC3 ..> BUC2 : <<include>>
@enduml
