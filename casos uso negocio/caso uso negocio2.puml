@startuml "BUC2 - Monitorear Buses y Aforo (Negocio)"
left to right direction
skinparam usecase {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam actor {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam Arrow {
  Color #7A1631
}

actor/ "Usuario ULima" <<Business Actor>> as User
actor/ "Operador de\nTransporte" <<Business Actor>> as Op

usecase/ "Monitorear\nBuses y Aforo" as BUC2
usecase/ "Conocer ubicación de\nlos buses en tiempo real" as B1
usecase/ "Conocer el aforo\ndisponible" as B2
usecase/ "Proveer Datos de\nRutas y Buses" as BUC6

User --> BUC2

BUC2 ..> B1 : <<include>>
BUC2 ..> B2 : <<include>>
BUC2 ..> BUC6 : <<include>>

Op --> BUC6
@enduml
