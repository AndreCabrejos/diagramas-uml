@startuml "BUC1 - Consultar Informacion de Viaje (Negocio)"
left to right direction
skinparam usecase {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam actor {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam Arrow {
  Color #7A1631
}

actor/ "Usuario ULima" <<Business Actor>> as User

usecase/ "Consultar\nInformación de Viaje" as BUC1
usecase/ "Conocer rutas y\nparaderos del Corredor Rojo" as B1
usecase/ "Conocer tiempos\nde recorrido" as B2
usecase/ "Monitorear\nBuses y Aforo" as BUC2

User --> BUC1

BUC1 ..> B1 : <<include>>
BUC1 ..> B2 : <<include>>
BUC1 ..> BUC2 : <<include>>
@enduml
