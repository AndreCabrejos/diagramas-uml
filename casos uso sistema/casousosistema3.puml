@startuml "BUC3 - Recibir Recomendaciones (Sistema)"
left to right direction
skinparam usecase {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam actor {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam rectangle {
  BorderColor #7A1631
}
skinparam Arrow {
  Color #7A1631
}

actor "Usuario ULima" as User
actor "Servicio de\nNotificaciones" as Notif <<External>>

rectangle "EsperaRojo ULima" {
  usecase "Iniciar sesión" as UC1
  usecase "Ver recomendaciones\nde viaje" as UC2
  usecase "Generar recomendación\nsegún aforo y horario" as UC3
  usecase "Recibir notificación\npush" as UC4
  usecase "Configurar preferencias\nde notificación" as UC5
}

User --> UC2
User --> UC4
User --> UC5

UC2 ..> UC1 : <<include>>
UC5 ..> UC1 : <<include>>
UC2 ..> UC3 : <<include>>
UC4 ..> UC3 : <<include>>

UC4 --> Notif
@enduml
