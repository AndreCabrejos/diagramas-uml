@startuml "BUC5 - Administrar Usuarios y Suscripciones (Sistema)"
left to right direction
skinparam usecase {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam actor {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam rectangle {
  BorderColor #7A1631
}
skinparam Arrow {
  Color #7A1631
}

actor "Administrador\ndel Sistema" as Admin
actor "Usuario ULima" as User
actor "Pasarela de Pago" as Pay <<External>>

rectangle "EsperaRojo ULima" {
  usecase "Iniciar sesión" as UC1
  usecase "Registrar cuenta" as UC2
  usecase "Gestionar usuarios" as UC3
  usecase "Suscribirse al\nplan premium" as UC4
  usecase "Procesar pago" as UC5
  usecase "Gestionar\nsuscripciones" as UC6
}

User --> UC2
User --> UC4
Admin --> UC3
Admin --> UC6

UC4 ..> UC1 : <<include>>
UC4 ..> UC5 : <<include>>
UC5 --> Pay
@enduml
