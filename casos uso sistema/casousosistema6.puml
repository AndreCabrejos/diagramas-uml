@startuml "BUC6 - Proveer Datos de Rutas y Buses (Sistema)"
left to right direction
skinparam usecase {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam actor {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam rectangle {
  BorderColor #7A1631
}
skinparam Arrow {
  Color #7A1631
}

actor "Operador de\nTransporte" as Op
actor "API Corredor Rojo" as BusAPI <<External>>

rectangle "EsperaRojo ULima" {
  usecase "Enviar posiciones GPS\nde los buses" as UC1
  usecase "Actualizar aforo\nde cada bus" as UC2
  usecase "Publicar rutas\ny paraderos" as UC3
  usecase "Sincronizar datos\nen la base de datos" as UC4
}

Op --> BusAPI
BusAPI --> UC1
BusAPI --> UC2
BusAPI --> UC3

UC1 ..> UC4 : <<include>>
UC2 ..> UC4 : <<include>>
UC3 ..> UC4 : <<include>>
@enduml
