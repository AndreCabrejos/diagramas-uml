@startuml "BUC1 - Consultar Informacion de Viaje (Sistema)"
left to right direction
skinparam usecase {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam actor {
  BackgroundColor #C7F4FF
  BorderColor #7A1631
}
skinparam rectangle {
  BorderColor #7A1631
}
skinparam Arrow {
  Color #7A1631
}

actor "Usuario ULima" as User
actor "Google Maps API" as Maps <<External>>

rectangle "EsperaRojo ULima" {
  usecase "Iniciar sesión" as UC1
  usecase "Consultar rutas\ndel Corredor Rojo" as UC2
  usecase "Ver paraderos\nen mapa interactivo" as UC3
  usecase "Ver detalle\nde paradero" as UC4
  usecase "Obtener ubicación\nGPS del usuario" as UC5
}

User --> UC2
User --> UC3
User --> UC4

UC2 ..> UC1 : <<include>>
UC3 ..> UC1 : <<include>>
UC3 ..> UC5 : <<include>>
UC4 ..> UC3 : <<extend>>

UC3 --> Maps
UC5 --> Maps
@enduml
