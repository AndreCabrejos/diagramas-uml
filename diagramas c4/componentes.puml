@startuml C3_Component

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_LEFT_RIGHT()

Person(usuario, "Usuario")

System_Boundary(s1, "EsperaRojo ULima") {

    Container(web, "Página Web Responsive", "React", "Interfaz de usuario")

    Container_Boundary(api, "API REST (Spring Boot)") {

        Component(auth, "AuthController", "REST Controller", "Autenticación de usuarios")
        Component(usuarioService, "UsuarioService", "Servicio", "Gestión de usuarios")
        Component(rutaService, "RutaService", "Servicio", "Gestión de rutas")
        Component(busService, "BusService", "Servicio", "Información de buses")
        Component(ubicacionService, "UbicacionService", "Servicio", "Ubicación de buses")
        Component(subscriptionService, "SubscriptionService", "Servicio", "Gestión de suscripciones")
        Component(paymentService, "PaymentService", "Servicio", "Procesamiento de pagos")
        Component(notificationService, "NotificationService", "Servicio", "Notificaciones")
        Component(recommendationService, "RecommendationService", "Servicio", "Recomendaciones")
    }

    ContainerDb(db, "MySQL", "Base de Datos", "Información del sistema")
}

System_Ext(maps, "Google Maps API", "Mapas")
System_Ext(payext, "Pasarela de Pago", "Pagos")
System_Ext(busapi, "API Corredor Rojo", "Información de buses")

Rel(usuario, web, "Usa")

Rel(web, auth, "Inicia sesión")
Rel(web, rutaService, "Consulta rutas")
Rel(web, busService, "Consulta aforo")
Rel(web, subscriptionService, "Gestiona suscripción")
Rel(web, recommendationService, "Solicita recomendaciones")

Rel(auth, usuarioService, "Autentica")
Rel(usuarioService, subscriptionService, "Consulta")
Rel(subscriptionService, paymentService, "Gestiona pagos")
Rel(rutaService, busService, "Consulta")
Rel(busService, ubicacionService, "Obtiene ubicación")
Rel(busService, recommendationService, "Envía información")
Rel(recommendationService, notificationService, "Genera alertas")

Rel(ubicacionService, maps, "Consulta mapas")
Rel(paymentService, payext, "Procesa pagos")
Rel(busService, busapi, "Consulta buses")

Rel(usuarioService, db, "CRUD")
Rel(rutaService, db, "CRUD")
Rel(busService, db, "CRUD")
Rel(ubicacionService, db, "CRUD")
Rel(subscriptionService, db, "CRUD")
Rel(paymentService, db, "CRUD")
Rel(notificationService, db, "CRUD")
Rel(recommendationService, db, "CRUD")

@enduml