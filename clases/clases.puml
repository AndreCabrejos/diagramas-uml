@startuml "EsperaRojo - Domain Model (Vista General)"

package "Identity Context" {

class Usuario <<Aggregate Root>> {
  - id : Long
  - nombre : String
  - correo : String
  - password : String

  + iniciarSesion() : Boolean
  + consultarRutas() : List<Ruta>
  + consultarAforo() : Integer
}

}

package "Transit Context" {

class Ruta <<Aggregate Root>> {
  - id : Long
  - nombre : String
  - direccion : String
  - tiempoRecorrido : Integer

  + obtenerParaderos() : List<Paradero>
}

class Paradero <<Entity>> {
  - id : Long
  - nombre : String
  - ubicacion : String

  + obtenerProximosBuses() : List<Bus>
}

class Bus <<Entity>> {
  - id : Long
  - codigo : String
  - capacidadMaxima : Integer
  - aforoActual : Integer
  - tiempoLlegada : Integer

  + calcularAforo() : Double
}

class Ubicacion <<Value Object>> {
  - id : Long
  - latitud : Double
  - longitud : Double
  - fechaRegistro : Date

  + obtenerDistancia() : Double
}

}

package "Subscription & Payment Context" {

class Suscripcion <<Aggregate Root>> {
  - id : Long
  - plan : String
  - fechaInicio : Date
  - fechaFin : Date
  - estado : EstadoSuscripcion

  + activar() : void
  + cancelar() : void
  + estaVigente() : Boolean
}

class Pago <<Entity>> {
  - id : Long
  - fechaPago : Date
  - monto : Decimal
  - estado : EstadoPago

  + procesarPago() : Boolean
}

enum EstadoSuscripcion {
  ACTIVA
  VENCIDA
  CANCELADA
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

}

package "Notification Context" {

class Notificacion <<Entity>> {
  - id : Long
  - mensaje : String
  - fecha : Date

  + enviar() : void
}

}

package "Recommendation Context" {

class Recomendacion <<Entity>> {
  - id : Long
  - descripcion : String

  + generarRecomendacion() : String
}

}

Pago --> EstadoPago : usa
Suscripcion --> EstadoSuscripcion : usa

Usuario "1" --> "1" Ubicacion : comparte
Usuario "1" --> "0..*" Suscripcion : contrata
Suscripcion "1" o-- "1..*" Pago : registra
Usuario "1" --> "0..*" Notificacion : recibe
Usuario "1" --> "0..*" Recomendacion : consulta

Ruta "1" o-- "1..*" Paradero : contiene
Ruta "1" o-- "1..*" Bus : asigna

Paradero "1" --> "0..*" Bus : recibe

Recomendacion --> Ruta
Recomendacion --> Paradero

@enduml