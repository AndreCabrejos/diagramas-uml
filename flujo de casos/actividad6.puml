@startuml "Actividad 6 - Proceso de Negocio: Administrar Suscripcion a Planes Premium"
skinparam SwimlaneTitleBackgroundColor #EEE
skinparam ActivityBackgroundColor #FFF9C4
skinparam ActivityBorderColor #7A1631
skinparam Arrow {
  Color #7A1631
}

|Usuario ULima|
start
:Quiere acceder a\nbeneficios adicionales\nde EsperaRojo;

|Sistema EsperaRojo|
:Presenta los planes de\nsuscripción disponibles\n(beneficios, precio y\nduración de cada uno);

|Usuario ULima|
:Compara los planes y\nelige el que más le\nconviene;
:Confirma su intención\nde suscribirse;

|Sistema EsperaRojo|
:Verifica que se haya\nelegido un plan válido;

if (¿Se indicó un\nplan a contratar?) then (No)
  :Solicita al usuario que\nelija un plan primero;
  |Usuario ULima|
  :Selecciona un plan\ny reintenta;
  stop
else (Sí)
  :Confirma que el plan\nelegido siga vigente\nen el catálogo;

  if (¿El plan elegido\nexiste y está vigente?) then (No)
    :Informa que el plan\nya no está disponible;
    |Usuario ULima|
    :Elige otro plan\nde la lista;
    stop
  else (Sí)
    :Define la vigencia de la\nsuscripción según la\nduración del plan elegido;
    :Activa la suscripción\ndel usuario;

    |Usuario ULima|
    :Recibe la confirmación\nde su suscripción activa\ny accede a los beneficios;
    stop
  endif
endif

note right
  Regla de negocio vigente hoy:
  el cobro aún no se procesa
  mediante una pasarela de pago,
  por lo que la suscripción se
  activa directamente al
  confirmarse la elección del plan.
end note

@enduml
