@startuml "Actividad 5 - Proceso de Negocio: Calculo de Aforo por Ruta (capacidad reutilizable)"
skinparam SwimlaneTitleBackgroundColor #EEE
skinparam ActivityBackgroundColor #FFF9C4
skinparam ActivityBorderColor #7A1631
skinparam Arrow {
  Color #7A1631
}

|Consumidor interno\n(hoy: Resumen de Inicio)|
start
:Necesita conocer qué tan\nlleno está el bus de\nuna ruta puntual;
:Solicita al sistema el nivel\nde aforo de esa ruta;

|Sistema EsperaRojo|
:Verifica que la ruta\nindicada sea válida;

if (¿La ruta indicada\nes válida?) then (No)
  :Informa que la ruta\nindicada no es reconocida;
  stop
else (Sí)
  :Revisa los buses que se\nencuentran activos\nen esa ruta;

  if (¿Hay buses activos\ncirculando en la ruta?) then (No)
    :Informa que por el momento\nno hay buses activos\nen esa ruta;
    |Consumidor interno\n(hoy: Resumen de Inicio)|
    :Comunica al usuario que no\nhay información disponible;
    stop
  else (Sí)
    :Calcula el nivel de aforo\npromedio de los buses\nactivos en la ruta;

    |Consumidor interno\n(hoy: Resumen de Inicio)|
    :Recibe el indicador de aforo\ny lo presenta según\nsu propio contexto;
    stop
  endif
endif

@enduml
